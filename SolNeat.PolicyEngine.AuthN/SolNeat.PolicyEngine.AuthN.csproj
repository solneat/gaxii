<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackageId>SolNeat.PolicyEngine</PackageId>
		<Version>1.0.0</Version>
		<Authors>SolNeat</Authors>
		<Company>SolNeat</Company>
		<Title>SolNeat PolicyEngine Core</Title>
		<Description>Base abstractions and lightweight standalone RBAC/ABAC PAP/PDP/PEP authorization engine using Actor-Role-Permission-Resource-Action model for .NET.</Description>
		<PackageTags>rbac;abac;authorization;headless;pdp;pep;policies;permissions;ddd;onion</PackageTags>		
		
		<!-- License, Icon & Docs -->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>		
		
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\logo.png" Pack="true" PackagePath="logo.png" />
		<None Include="..\README.md" Pack="true" PackagePath="README.md" />
	</ItemGroup>
	
	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
	</ItemGroup>

</Project>